# bridge-msc — configuracion de ejemplo.
# Copiala a /etc/bridge-msc.env (o donde apunte el EnvironmentFile de la
# unit systemd) y editala. La observabilidad viene APAGADA por defecto: asi el
# agente es un bridge puro y no publica nada a ningun mapa.

# ---------------------------------------------------------------------------
# NODO MESHCORE
# ---------------------------------------------------------------------------
# ADVERTENCIA: este agente es dueno EXCLUSIVO del puerto del nodo. Si otro
# proceso (un publisher de mapa, un bot, un clock-sync) tiene el mismo serial
# abierto, van a pelearse el puerto y ninguno va a funcionar bien.

MC_TRANSPORT=serial            # serial | tcp | ble
MC_ADDRESS=/dev/ttyACM0        # serial: el puerto | tcp: host:puerto | ble: nombre del equipo
MC_BAUD=115200                 # solo serial

# ---------------------------------------------------------------------------
# CANAL PUBLICO
# ---------------------------------------------------------------------------
# PRERREQUISITO: el nodo TIENE que tener el canal publico ya configurado
# (nombre + clave compartida) y estar en el indice de canal que declares aca.
# El agente no configura el canal; solo lo usa.

CHANNEL_NAME=publica           # nombre del canal, tal cual esta en el nodo
CHANNEL_IDX=0                  # indice del canal en el nodo (0 suele ser el publico)
ISLAND_IATA=SCL                # etiqueta de procedencia de TU isla (aparece como "[SCL] ...")

# Topic (spec §5): <prefix>[/<region>]/<channel>
# Con esto queda: meshchan/CL/publica
CHAN_TOPIC_PREFIX=meshchan
CHAN_REGION=CL

# ---------------------------------------------------------------------------
# HUB MQTT DEL CANAL (siempre necesario)
# ---------------------------------------------------------------------------
# Cualquier broker MQTT compatible sirve (Mosquitto, por ejemplo). NO se
# necesita un broker que sepa de MeshCore.
CHAN_MQTT_HOST=hub.ejemplo.cl
CHAN_MQTT_PORT=443
CHAN_MQTT_WS_PATH=/mqtt
CHAN_MQTT_TLS=true
CHAN_MQTT_USER=bridge-scl
CHAN_MQTT_PASS=cambiame
# Solo si el broker usa un certificado propio / autofirmado:
#CHAN_MQTT_CA_FILE=/etc/bridge-msc/ca.pem

# ---------------------------------------------------------------------------
# LIMITES DE AIRTIME (spec §8.4)
# ---------------------------------------------------------------------------
# Aplican SOLO a la inyeccion MQTT -> RF. Lo que se oye por radio se publica
# siempre. Estos limites son un mecanismo de seguridad, no una perilla de
# tuning: subirlos mucho satura la RF de tu isla.
RATE_PER_MIN=10                # recarga sostenida de tokens
RATE_BURST=5                   # rafaga maxima
RATE_MIN_INTERVAL_S=3          # separacion minima entre inyecciones
# Techo del texto inyectado, en bytes. OJO: el firmware corta el mensaje de
# canal en 160 bytes CONTANDO el prefijo "<nombre_del_nodo>: " que agrega solo,
# asi que el agente recalcula el techo efectivo al arrancar y lo deja en el log.
MAX_TEXT_LEN=178

# Cache de deduplicacion (acotada en tiempo y en tamano).
DEDUP_TTL_S=600
DEDUP_MAX=4096

# ---------------------------------------------------------------------------
# OBSERVABILIDAD (OPCIONAL — plano separado, ver spec §11)
# ---------------------------------------------------------------------------
# Con OBS_ENABLED=false no se crea el segundo cliente MQTT ni se llama nunca a
# get_contacts: el modulo no cuesta nada. Enciendelo solo si acordaste con el
# operador del mapa publicar los nodos que ve tu observer.
OBS_ENABLED=false
#MAP_MQTT_HOST=mqtt.ejemplo.cl
#MAP_MQTT_PORT=443
#MAP_MQTT_WS_PATH=/mqtt
#MAP_MQTT_TLS=true
#MAP_IATA=SCL
#GATEWAY_TOKEN=el-token-que-te-dio-el-operador-del-mapa
# Opcional: si no lo pones, se autodetecta la pubkey del propio nodo.
#GATEWAY_PUBLIC_KEY=
#MAP_INTERVAL=60
#MAP_MQTT_CA_FILE=/etc/bridge-msc/ca-mapa.pem

# ---------------------------------------------------------------------------
# LOGS
# ---------------------------------------------------------------------------
# info por defecto. Para depurar el bridge: bridge_msc=debug
#RUST_LOG=info
